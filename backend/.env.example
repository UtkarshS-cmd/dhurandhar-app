# Local development defaults. Real environment variables always take
# precedence over this file. Copy to backend/.env (run.bat does this
# automatically on Windows).
#
# APP_ENV selects the security configuration:
#   development (default) - works without a JWT_SECRET; an ephemeral,
#       development-only secret is generated per process (sessions reset on
#       restart) and a warning is printed at startup.
#   production - startup FAILS unless a real JWT_SECRET (>= 32 chars) is
#       provided. Generate one with:
#           python -c "import secrets; print(secrets.token_urlsafe(48))"
#       Never commit a real secret to this repository.
APP_ENV=development

DATABASE_URL=sqlite:///./dhurandhar.db

# Required when APP_ENV=production; optional in development (placeholder or
# short values are ignored there and an ephemeral secret is used instead).
# Leave commented for the default development behavior.
# JWT_SECRET=

PAYMENT_MODE=mock

# Comma-separated explicit browser origins. "*" is rejected (credentialed
# CORS is enabled). Unset -> localhost origins in development, same-origin
# only in production.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
